@model User
@{ ViewData["Title"] = "编辑计费用户"; }

<h2 class="mb-4">✏️ 编辑用户</h2>
<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="EditUser" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Username" class="form-label">登录编号</label>
                    <input asp-for="Username" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Password" class="form-label">密码（留空不修改）</label>
                    <input asp-for="Password" class="form-control" type="text" placeholder="留空则不修改" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Name" class="form-label">姓名</label>
                    <input asp-for="Name" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Gender" class="form-label">性别</label>
                    <select asp-for="Gender" class="form-select">
                        <option value="0">未知</option><option value="1">男</option><option value="2">女</option>
                    </select>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Age" class="form-label">年龄</label>
                    <input asp-for="Age" class="form-control" type="number" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="HeightCm" class="form-label">身高(cm)</label>
                    <input asp-for="HeightCm" class="form-control" type="number" step="0.1" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="WeightKg" class="form-label">体重(kg)</label>
                    <input asp-for="WeightKg" class="form-control" type="number" step="0.1" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 mb-3">
                    <label asp-for="Phone" class="form-label">信息推送Token（选填）</label>
                    <input asp-for="Phone" class="form-control" placeholder="PushPlus微信token，填写后更新数据会推送扣费/余额提醒到微信" />
                    <span class="form-text text-muted">可留空；留空则清空原有token，不再推送</span>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">保存修改</button>
            <a asp-action="Users" class="btn btn-secondary">取消</a>
        </form>
    </div>
</div>
