@{
    ViewData["Title"] = "智能饮水机管理系统";
    Layout = null;
}

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>智能饮水机管理系统</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            background:
                radial-gradient(circle at 15% 20%, rgba(255,255,255,0.25) 0%, transparent 45%),
                radial-gradient(circle at 85% 15%, rgba(255,240,220,0.30) 0%, transparent 40%),
                radial-gradient(circle at 80% 85%, rgba(160,90,50,0.35) 0%, transparent 50%),
                radial-gradient(circle at 20% 80%, rgba(255,255,255,0.18) 0%, transparent 40%),
                linear-gradient(135deg, #f7dfc0 0%, #e8c8a0 30%, #d4946a 65%, #b8774f 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            position: relative;
        }
        .container {
            max-width: 1100px;
            padding: 20px;
            margin-top: 80px;
        }
        .title {
            text-align: center;
            color: white;
            margin-bottom: 40px;
        }
        .title h1 {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 10px;
            text-shadow: 0 2px 10px rgba(0,0,0,0.3);
        }
        .title p {
            font-size: 1.1rem;
            opacity: 0.9;
        }
        .section-cards {
            display: flex;
            gap: 20px;
            justify-content: center;
        }
        .section-card {
            background: #fff;
            border-radius: 20px;
            padding: 32px 20px 26px;
            flex: 1;
            max-width: 240px;
            min-width: 160px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
            transition: transform 0.3s, box-shadow 0.3s;
            cursor: pointer;
            text-decoration: none;
            color: #333;
            display: block;
            position: relative;
            overflow: hidden;
        }
        .section-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.2);
            color: #333;
        }
        /* 卡片专属背景渐变 */
        .card-elderly {
            background: linear-gradient(165deg, #e2f2df 0%, #f6fbf4 55%, #ffffff 100%);
        }
        .card-billing {
            background: linear-gradient(165deg, #dceafb 0%, #f2f8ff 55%, #ffffff 100%);
        }
        .card-home {
            background: linear-gradient(165deg, #ffe8c9 0%, #fff6ea 55%, #ffffff 100%);
        }
        .card-coming {
            background: linear-gradient(165deg, #e8ddf5 0%, #f7f2fc 55%, #ffffff 100%);
        }
        /* 背景装饰大图标（半透明，不挡点击） */
        .section-card .deco {
            position: absolute;
            font-size: 4.5rem;
            opacity: 0.12;
            z-index: 0;
            pointer-events: none;
        }
        .deco-e1 { top: -6px; right: -6px; transform: rotate(12deg); }
        .deco-e2 { bottom: -10px; left: -8px; transform: rotate(-10deg); }
        .deco-b1 { top: -6px; right: -6px; transform: rotate(-8deg); }
        .deco-b2 { bottom: -12px; left: -6px; }
        .deco-h1 { top: -8px; left: -8px; }
        .deco-h2 { bottom: -10px; right: -8px; transform: rotate(14deg); }
        .deco-c1 { top: -8px; right: -8px; }
        .deco-c2 { bottom: -8px; left: -6px; }
        /* 图标徽章 */
        .section-card .icon-wrap {
            width: 92px;
            height: 92px;
            margin: 0 auto 14px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.6rem;
            position: relative;
            z-index: 1;
            box-shadow: 0 8px 20px rgba(0,0,0,0.14);
        }
        .section-card .main-icon {
            animation: iconFloat 3s ease-in-out infinite;
        }
        .card-elderly .icon-wrap { background: linear-gradient(135deg, #9fd49a, #6d9a68); }
        .card-billing .icon-wrap { background: linear-gradient(135deg, #7aa6d6, #4f76a8); }
        .card-home .icon-wrap   { background: linear-gradient(135deg, #f0b877, #d4946a); }
        .card-coming .icon-wrap { background: linear-gradient(135deg, #a98fd0, #7f64a8); }
        @@keyframes iconFloat {
            0%, 100% { transform: translateY(0); }
            50%      { transform: translateY(-6px); }
        }
        .section-card h3,
        .section-card p {
            position: relative;
            z-index: 1;
        }
        .section-card h3 {
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 8px;
        }
        .section-card p {
            font-size: 0.8rem;
            color: #888;
            margin-bottom: 0;
        }
        /* 各板块标题色 */
        .card-elderly h3 { color: #4a7a3f; }
        .card-billing h3 { color: #3f6a9a; }
        .card-home h3   { color: #b8774f; }
        .card-coming h3 { color: #7a5a9a; }
        .footer-text {
            text-align: center;
            color: rgba(255,255,255,0.6);
            margin-top: 40px;
            font-size: 0.85rem;
        }
        /* 顶部品牌栏：logo在左上角，标语和它放一起 */
        .brand-bar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            display: flex;
            align-items: center;
            justify-content: flex-start;
            gap: 14px;
            background: linear-gradient(135deg, #d4946a 0%, #b8774f 100%);
            padding: 10px 24px;
            box-shadow: 0 2px 12px rgba(180,100,50,0.3);
            z-index: 999;
        }
        .brand-bar-logo {
            width: 44px;
            height: 44px;
            object-fit: contain;
            border-radius: 8px;
            background: rgba(255,255,255,0.15);
            padding: 2px;
        }
        .brand-bar-title {
            color: #fff;
            font-size: 1.2rem;
            font-weight: 700;
            letter-spacing: 2px;
            text-shadow: 0 1px 4px rgba(0,0,0,0.2);
            white-space: nowrap;
        }
        .brand-bar-slogan {
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            color: #fff;
            font-size: 1.7rem;
            font-weight: 700;
            letter-spacing: 8px;
            text-shadow: 0 0 8px rgba(255,255,255,0.25), 0 1px 4px rgba(0,0,0,0.35);
            white-space: nowrap;
        }
        .brand-bar-right {
            margin-left: auto;
            display: flex;
            align-items: center;
        }
        .login-dropdown {
            position: relative;
        }
        .brand-bar-login {
            background: rgba(255,255,255,0.18);
            border: 1px solid rgba(255,255,255,0.45);
            color: #fff;
            padding: 6px 18px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
            text-decoration: none;
        }
        .brand-bar-login:hover {
            background: rgba(255,255,255,0.35);
            color: #fff;
        }
        .login-menu {
            display: none;
            position: absolute;
            right: 0;
            top: calc(100% + 8px);
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.18);
            padding: 6px;
            min-width: 170px;
            z-index: 1000;
        }
        .login-menu a {
            display: block;
            padding: 9px 14px;
            border-radius: 8px;
            color: #333;
            text-decoration: none;
            font-size: 0.9rem;
            white-space: nowrap;
        }
        .login-menu a:hover {
            background: #f5efe8;
            color: #b8774f;
        }
        .login-dropdown:hover .login-menu,
        .login-dropdown.open .login-menu {
            display: block;
        }
        /* ===== 暖色水主题背景装饰 ===== */
        .container {
            position: relative;
            z-index: 1;
        }
        .bg-water {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            overflow: hidden;
            z-index: 0;
            pointer-events: none;
        }
        /* 上升水泡 */
        .bubble {
            position: absolute;
            border-radius: 50%;
            background: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.40), rgba(255,255,255,0.06) 65%);
            border: 1px solid rgba(255,255,255,0.30);
        }
        .bubble::after {
            content: '';
            position: absolute;
            width: 20%;
            height: 20%;
            border-radius: 50%;
            background: rgba(255,255,255,0.60);
            top: 18%;
            left: 22%;
        }
        .b1 { width: 100px; height: 100px; bottom: -40px; left: 6%;    animation: floatUp 14s ease-in infinite; }
        .b2 { width: 55px;  height: 55px;  bottom: -30px; left: 22%;   animation: floatUp 11s ease-in infinite 3s; }
        .b3 { width: 75px;  height: 75px;  bottom: -35px; right: 30%;  animation: floatUp 16s ease-in infinite 5s; }
        .b4 { width: 42px;  height: 42px;  bottom: -25px; right: 10%;  animation: floatUp 9s  ease-in infinite 7s; }
        .b5 { width: 65px;  height: 65px;  bottom: -30px; left: 45%;   animation: floatUp 13s ease-in infinite 9s; }
        @@keyframes floatUp {
            0%   { transform: translateY(0) scale(1); opacity: 0.5; }
            50%  { transform: translateY(-45vh) scale(1.08); opacity: 0.9; }
            100% { transform: translateY(-90vh) scale(0.90); opacity: 0; }
        }
        /* 中央水波涟漪 */
        .ripple {
            position: absolute;
            left: 50%;
            top: 50%;
            border: 3px solid rgba(255,255,255,0.18);
            border-radius: 50%;
            transform: translate(-50%, -50%);
            animation: ripple 8s ease-out infinite;
        }
        .r1 { width: 120px; height: 120px; }
        .r2 { width: 120px; height: 120px; animation-delay: 2.7s; }
        .r3 { width: 120px; height: 120px; animation-delay: 5.4s; }
        @@keyframes ripple {
            0%   { width: 120px; height: 120px; opacity: 0.7; }
            100% { width: 110vmin; height: 110vmin; opacity: 0; }
        }
        /* 科技感光点 */
        .tech-dot {
            position: absolute;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: rgba(255,255,255,0.55);
            box-shadow: 0 0 12px rgba(255,255,255,0.6);
            animation: twinkle 4s ease-in-out infinite;
        }
        .d1 { top: 22%; left: 12%; }
        .d2 { top: 30%; right: 18%; animation-delay: 1.3s; }
        .d3 { top: 18%; left: 48%; animation-delay: 2.1s; }
        .d4 { bottom: 25%; left: 20%; animation-delay: 0.7s; }
        .d5 { bottom: 20%; right: 15%; animation-delay: 1.9s; }
        @@keyframes twinkle {
            0%, 100% { opacity: 0.2; transform: scale(0.8); }
            50%      { opacity: 0.9; transform: scale(1.3); }
        }
        /* 窄屏：标语缩小避免与左右内容重叠 */
        @@media (max-width: 768px) {
            .brand-bar-slogan { font-size: 1.05rem; letter-spacing: 4px; }
        }
    </style>
</head>
<body>
    <!-- 暖色水主题背景装饰 -->
    <div class="bg-water">
        <div class="ripple r1"></div>
        <div class="ripple r2"></div>
        <div class="ripple r3"></div>
        <div class="bubble b1"></div>
        <div class="bubble b2"></div>
        <div class="bubble b3"></div>
        <div class="bubble b4"></div>
        <div class="bubble b5"></div>
        <div class="tech-dot d1"></div>
        <div class="tech-dot d2"></div>
        <div class="tech-dot d3"></div>
        <div class="tech-dot d4"></div>
        <div class="tech-dot d5"></div>
    </div>

    <!-- 顶部品牌栏：Logo + 标语 + 右上角登录 -->
    <div class="brand-bar">
        <img src="~/images/logo.png" alt="logo" class="brand-bar-logo" />
        <span class="brand-bar-title">智能饮水机管理</span>
        <span class="brand-bar-slogan">智慧饮水，净润朝夕</span>
        <div class="brand-bar-right">
            <div class="login-dropdown">
                <a class="brand-bar-login" href="javascript:void(0)">🔐 登录 ▾</a>
                <div class="login-menu">
                    <a href="/Account/Login?section=elderly">🏥 养老院板块</a>
                    <a href="/Account/Login?section=billing">💰 个人计费板块</a>
                    <a href="/Account/Login?section=home">🏠 家庭板块</a>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="title">
            <h1>🚰 智能饮水机管理系统</h1>
            <p>请选择您要进入的板块</p>
        </div>

        <div class="section-cards">
            <!-- 养老院板块：绿意温馨 · 关爱主题 -->
            <a class="section-card card-elderly" href="/Account/Login?section=elderly">
                <span class="deco deco-e1">🍃</span>
                <span class="deco deco-e2">❤️</span>
                <div class="icon-wrap"><span class="main-icon">👵</span></div>
                <h3>养老院板块</h3>
                <p>管理员、护工、老人饮水管理</p>
            </a>

            <!-- 个人计费板块：蓝金商务 · 计费主题 -->
            <a class="section-card card-billing" href="/Account/Login?section=billing">
                <span class="deco deco-b1">💳</span>
                <span class="deco deco-b2">🪙</span>
                <div class="icon-wrap"><span class="main-icon">💰</span></div>
                <h3>个人计费板块</h3>
                <p>按量计费、余额管理、自助充值</p>
            </a>

            <!-- 家庭板块：暖阳温馨 · 家庭主题 -->
            <a class="section-card card-home" href="/Account/Login?section=home">
                <span class="deco deco-h1">☀️</span>
                <span class="deco deco-h2">🏡</span>
                <div class="icon-wrap"><span class="main-icon">🏠</span></div>
                <h3>家庭板块</h3>
                <p>家庭饮水管理</p>
            </a>

            <!-- 敬请期待板块：梦幻未来 · 期待主题 -->
            <a class="section-card card-coming" href="/Home/ComingSoon">
                <span class="deco deco-c1">🚀</span>
                <span class="deco deco-c2">✨</span>
                <div class="icon-wrap"><span class="main-icon">🔮</span></div>
                <h3>敬请期待板块</h3>
                <p>更多功能，即将上线</p>
            </a>
        </div>

        <div class="footer-text">
            Powered by ASP.NET Core &copy; 2026
        </div>
    </div>
</body>
</html>
