@model List<User>
@{
    ViewData["Title"] = "用户信息管理";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>👥 用户信息管理</h2>
    <a asp-action="AddUser" class="btn btn-primary">➕ 添加用户</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>编号</th>
                    <th>姓名</th>
                    <th>角色</th>
                    <th>性别</th>
                    <th>年龄</th>
                    <th>身高(cm)</th>
                    <th>体重(kg)</th>
                    <th>微信推送</th>
                    <th>创建时间</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.Username</td>
                        <td>@user.Name</td>
                        <td>
                            @if (user.Role == 0)
                            {
                                <span class="badge bg-warning text-dark role-badge">管理员</span>
                            }
                            else if (user.Role == 1)
                            {
                                <span class="badge bg-info text-dark role-badge">护工</span>
                            }
                            else
                            {
                                <span class="badge bg-success role-badge">饮水者</span>
                            }
                        </td>
                        <td>@user.GenderName</td>
                        <td>@(user.Age > 0 ? user.Age.ToString() : "-")</td>
                        <td>@(user.HeightCm > 0 ? user.HeightCm.ToString("F1") : "-")</td>
                        <td>@(user.WeightKg > 0 ? user.WeightKg.ToString("F1") : "-")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(user.Phone))
                            {
                                <span class="badge bg-success">已绑定</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">未绑定</span>
                            }
                        </td>
                        <td>@user.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(user.Phone))
                            {
                                <form asp-action="TestPush" asp-route-id="@user.Id" method="post" style="display:inline">
                                    <button type="submit" class="btn btn-sm btn-outline-success">测试推送</button>
                                </form>
                            }
                            <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">编辑</a>
                            @if (user.Role != 0)
                            {
                                <form asp-action="DeleteUser" asp-route-id="@user.Id" method="post"
                                      onsubmit="return confirm('确定要删除用户【@user.Name】吗？')" style="display:inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">删除</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="9" class="text-center text-muted py-4">暂无用户</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    /* 角色徽章统一宽度：护工（2字）与管理员/饮水者（3字）对齐 */
    .role-badge {
        min-width: 4em;
        display: inline-block;
        text-align: center;
    }
</style>
