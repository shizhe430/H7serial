@model DashboardViewModel
@{
    ViewData["Title"] = "我的饮水";
}

<div class="mb-4">
    <h2>💧 欢迎回来，@Model.Name</h2>
    <p class="text-muted">@DateTime.Now.ToString("yyyy年MM月dd日")</p>
</div>

<div class="row">
    <!-- 今日总水量卡片 -->
    <div class="col-md-4 mb-4">
        <div class="card shadow-sm h-100 border-info">
            <div class="card-body text-center">
                <div class="text-muted small">今日已饮水</div>
                <div class="display-3 fw-bold text-info">@Model.TodayTotalMl</div>
                <div class="text-muted">毫升 (ml)</div>

                <div class="mt-3">
                    <div class="d-flex justify-content-between small">
                        <span>目标 @Model.TargetMl ml</span>
                        <span>完成 @(Model.ProgressPercent.ToString("F0"))%</span>
                    </div>
                    <div class="progress" style="height: 15px;">
                        <div class="progress-bar @(Model.ProgressPercent >= 100 ? "bg-success" : "bg-info")"
                             role="progressbar"
                             style="width: @(Model.ProgressPercent)%"
                             aria-valuenow="@Model.ProgressPercent" aria-valuemin="0" aria-valuemax="100">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 次数和还需 -->
    <div class="col-md-4 mb-4">
        <div class="card shadow-sm h-100 border-warning">
            <div class="card-body">
                <div class="row text-center h-100 align-items-center">
                    <div class="col-6">
                        <div class="text-muted small">饮水次数</div>
                        <div class="display-5 fw-bold text-warning">@Model.TodayUseCount</div>
                        <div class="text-muted">次</div>
                    </div>
                    <div class="col-6">
                        <div class="text-muted small">还需饮水</div>
                        <div class="display-5 fw-bold @(Model.NeededMl > 0 ? "text-danger" : "text-success")">@Model.NeededMl</div>
                        <div class="text-muted">毫升</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 个人信息 -->
    <div class="col-md-4 mb-4">
        <div class="card shadow-sm h-100 border-secondary">
            <div class="card-header bg-light">
                <h6 class="mb-0">👤 我的信息</h6>
            </div>
            <div class="card-body">
                <table class="table table-sm mb-0">
                    <tr><td>身高</td><td>@(Model.HeightCm > 0 ? $"{Model.HeightCm} cm" : "未设置")</td></tr>
                    <tr><td>体重</td><td>@(Model.WeightKg > 0 ? $"{Model.WeightKg} kg" : "未设置")</td></tr>
                    <tr><td>年龄</td><td>@(Model.Age > 0 ? $"{Model.Age} 岁" : "未设置")</td></tr>
                    <tr><td>建议水量</td><td>@Model.TargetMl ml/天</td></tr>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- 饮水建议 -->
@if (!string.IsNullOrEmpty(Model.Advice))
{
    <div class="card shadow-sm mb-4 border-success">
        <div class="card-body">
            <h5 class="card-title text-success">💡 饮水建议</h5>
            <p class="card-text fs-5">@Model.Advice</p>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(Model.AiAdvice))
{
    <div class="card shadow-sm mb-4 border-info">
        <div class="card-body">
            <h5 class="card-title text-info">🤖 AI 智能饮水建议 <span class="badge bg-info text-dark">DeepSeek</span></h5>
            <p class="card-text fs-5">@Model.AiAdvice</p>
        </div>
    </div>
}

<!-- 近7天趋势 -->
<div class="card shadow-sm mb-4">
    <div class="card-header">
        <h5 class="mb-0">📈 近7天饮水趋势</h5>
    </div>
    <div class="card-body">
        @if (Model.RecentWeek.Any())
        {
            var maxMl = Model.RecentWeek.Max(w => w.TargetMl);
            if (maxMl == 0) maxMl = 1;
            <div style="height: 220px; display: flex; align-items: flex-end; gap: 8px; padding: 0 10px;">
                @foreach (var day in Model.RecentWeek)
                {
                    var barHeight = Math.Max(5, (double)day.TotalMl / maxMl * 180);
                    var targetHeight = Math.Max(5, (double)day.TargetMl / maxMl * 180);
                    <div class="flex-fill text-center" title="@day.DateStr: @day.TotalMl ml / @day.TargetMl ml">
                        <div style="position: relative; height: 180px; display: flex; align-items: flex-end; justify-content: center; gap: 3px;">
                            <div style="width: 35%; background: #e9ecef; border-radius: 4px 4px 0 0; height: @(targetHeight)px;" title="目标 @day.TargetMl ml"></div>
                            <div style="width: 35%; background: @(day.TotalMl >= day.TargetMl ? "#28a745" : "#17a2b8"); border-radius: 4px 4px 0 0; height: @(barHeight)px;" title="实际 @day.TotalMl ml"></div>
                        </div>
                        <div class="mt-1">
                            <small class="fw-bold">@day.TotalMl</small>
                            <br>
                            <small class="text-muted">@day.DateStr</small>
                        </div>
                    </div>
                }
            </div>
            <div class="mt-2 text-center small text-muted">
                <span style="display:inline-block; width:12px; height:12px; background:#e9ecef; border-radius:2px;"></span> 目标
                <span style="display:inline-block; width:12px; height:12px; background:#17a2b8; border-radius:2px; margin-left:10px;"></span> 实际
                <span style="display:inline-block; width:12px; height:12px; background:#28a745; border-radius:2px; margin-left:10px;"></span> 达标
            </div>
        }
        else
        {
            <p class="text-muted text-center">暂无历史数据</p>
        }
    </div>
</div>

<!-- 今日饮水记录 -->
<div class="card shadow-sm">
    <div class="card-header">
        <h5 class="mb-0">📋 今日饮水记录</h5>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>时间</th>
                    <th>饮水量(ml)</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.RecentRecords.Any())
                {
                    @foreach (var r in Model.RecentRecords)
                    {
                        <tr>
                            <td>@r.DateStr</td>
                            <td>@r.TotalMl</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="2" class="text-center text-muted py-3">今日还没有饮水记录。去喝杯水吧！🚰</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- AI 交互问答 -->
@{
    ViewData["ChatUserId"] = Model.UserId;
    ViewData["ChatUserName"] = Model.Name;
    ViewData["AskAIUrl"] = Url.Action("AskAI", "Drinker");
}
@await Html.PartialAsync("_AIChat")
